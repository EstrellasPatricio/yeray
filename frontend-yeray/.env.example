# Copia este archivo como .env y ajusta los valores. No incluyas secretos:
# todo lo que empieza por WXT_ acaba dentro del código de la extensión.

# URL base de la API principal, sin barra final.
WXT_API_BASE_URL=http://localhost:3000

# true: usa el cliente de autenticación simulado (no necesita backend).
# false: llama a la API real en WXT_API_BASE_URL.
WXT_AUTH_MOCK=true

# Solo con el cliente simulado. true: el registro pide confirmar el correo y la
# cuenta se da por confirmada a los 10 segundos.
WXT_AUTH_MOCK_EMAIL_CONFIRMATION=false

# Consulta de reputación (VirusTotal a través del backend). Vacío o false usa
# POST /reputation de la API real. Para probar sin backend, indica el escenario:
# analyzed, rate_limited, timeout, not_found, no_analysis, missing_configuration,
# upstream_error, invalid_response, network_error, invalid_site o server_error.
WXT_REPUTATION_MOCK=
