# Copia este archivo como .env y ajusta los valores. No incluyas secretos:
# todo lo que empieza por WXT_ acaba dentro del código de la extensión.

# URL base de la API principal, sin barra final.
WXT_API_BASE_URL=http://localhost:3000

# true: usa el cliente de autenticación simulado (no necesita backend).
# false: llama a la API real en WXT_API_BASE_URL.
WXT_AUTH_MOCK=true
